# ==========================================
# 大模型 API 配置（复制此文件为 .env 并填写真实值）
# 支持 OpenAI / DeepSeek 等兼容接口
# ==========================================

# API 密钥（必填）
# OpenAI 用户: 在 https://platform.openai.com/api-keys 获取
# DeepSeek 用户: 在 https://platform.deepseek.com/api_keys 获取
LLM_API_KEY=your_api_key

# API 地址（可选，默认 OpenAI 官方）
# DeepSeek 用户请取消注释下一行:
LLM_BASE_URL=your_base_url

# 模型名称
# OpenAI 推荐: gpt-4o-mini（性价比高）或 gpt-4o（效果更好）
# DeepSeek 推荐: deepseek-chat
LLM_MODEL=your_model_name
